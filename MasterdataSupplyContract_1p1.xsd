<xsd:schema xmlns:rsm="http://www.strom.ch" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ccts="urn:un:unece:uncefact:documentation:standard:CoreComponentsTechnicalSpecification:2" xmlns:ram="urn:un:unece:uncefact:data:draft:ReusableAggregateBusinessInformationEntity:2" targetNamespace="http://www.strom.ch" elementFormDefault="qualified" attributeFormDefault="unqualified" version="11">
	<!--=======================================================================-->
	<!--===========================   MasterdataSupplyContract_11 Schema Module   ===================-->
	<!--=======================================================================-->
	<xsd:import namespace="urn:un:unece:uncefact:data:draft:ReusableAggregateBusinessInformationEntity:2" schemaLocation="ReusableAggregateBusinessInformationEntity_2p0.xsd"/>
	<xsd:include schemaLocation="MasterdataSupplyContract_CoreComponents_1p1.xsd"/>
	<xsd:element name="MasterdataSupplyContract_11" type="rsm:MasterdataSupplyContractType_11">
		<xsd:annotation>
			<xsd:documentation xml:lang="en">Notification of supply contract masterdata</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:complexType name="MasterdataSupplyContractType_11">
		<xsd:annotation>
			<xsd:documentation>Complex type used for defining the element Masterdata Supply Contract, version 1.0</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="MasterdataSupplyContract_HeaderInformation" type="rsm:EnergyStandardBusinessDocumentHeaderType"/>
			<xsd:element name="Instance" maxOccurs="unbounded">
				<xsd:complexType>
					<xsd:complexContent>
						<xsd:extension base="rsm:EnergyTransactionType">
							<xsd:sequence>
								<xsd:element name="RequestedTransaction" type="rsm:AcceptanceStatusType" minOccurs="0" maxOccurs="1">
									<xsd:annotation>
										<xsd:documentation xml:lang="en">Resulting status of the original request that is responded to in this document.</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="ReferenceToRequestingDocumentID" type="rsm:DocumentIdentifierType" minOccurs="0" maxOccurs="1">
									<xsd:annotation>
										<xsd:documentation xml:lang="en">Reference to the ID of the request that triggered this response.</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="MeteringPoint" minOccurs="0" maxOccurs="1">
									<xsd:complexType>
										<xsd:complexContent>
											<xsd:extension base="rsm:EnergyMeteringPointLocationType">
												<xsd:sequence>
													<xsd:element name="ContractTerminationInformation" type="rsm:ContractTerminationInformationType"/>
												</xsd:sequence>
											</xsd:extension>
										</xsd:complexContent>
									</xsd:complexType>
								</xsd:element>
							</xsd:sequence>
						</xsd:extension>
					</xsd:complexContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>
